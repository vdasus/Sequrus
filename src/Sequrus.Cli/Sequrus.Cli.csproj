<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sequrus</ToolCommandName>
    <PackageId>Sequrus.Cli</PackageId>
    <Description>Command-line tool for Sequrus: generate keys, encrypt, decrypt and re-encrypt values.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Optionus" Version="0.9.0" />
    <ProjectReference Include="..\Sequrus\Sequrus.csproj" />
  </ItemGroup>

</Project>
