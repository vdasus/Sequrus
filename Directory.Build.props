<Project>
  <!-- WSL builds get their own bin/wsl and obj/wsl, so they never share restore and build state with Visual Studio on Windows. -->
  <PropertyGroup Condition="'$(WSL_DISTRO_NAME)' != ''">
    <BaseIntermediateOutputPath>obj/wsl/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/wsl/</BaseOutputPath>
    <!-- The Windows obj/ and bin/ hold generated .cs files that must not be compiled here. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <!-- Maps local source paths to /_/ in DLL and PDB files, so packages carry no machine paths. -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>

    <!-- SemVer. -->
    <Version>0.2.1</Version>
    <Authors>vdasus</Authors>
    <Copyright>vdasus</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/vdasus/Sequrus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vdasus/Sequrus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>encryption;decryption;aes;aes-gcm;aes-256;crypto;security;secrets;secret-management;connection-string;configuration;appsettings;key-rotation;pbkdf2;dotnet-tool;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
